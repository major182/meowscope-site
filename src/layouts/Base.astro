---
// すべてのページの共通の外枠（要件 F-NV-01）
// 上部：運営の名前とトップへのリンク。下部：運営者の情報・事業の連絡へのリンクと著作権の表示
// スクリプトは使わない（要件 NF-SC-02）。見た目はこのファイルの CSS だけで決める
interface Props {
  /** ページの題名（ブラウザーのタブに出す） */
  title: string;
  /** 検索結果などに出す説明 */
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === "MeowScope" ? title : `${title} | MeowScope`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">
          MeowScope
        </a>
      </div>
    </header>
    <main class="inner">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <nav aria-label="運営者の情報">
          <a href="/about/">運営者の情報</a>
          <a href="/contact/">事業の連絡</a>
        </nav>
        <p>&copy; 2026 MeowScope</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* 色はアプリ MeowScope の色（#C2662D）に合わせる（要件 Q-03）。端末の暗い表示にも合わせる（NF-UX-03） */
  :root {
    --accent: #a8521f;
    --text: #2b2420;
    --muted: #6b5f57;
    --bg: #fffaf6;
    --surface: #ffffff;
    --border: #ead9cc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --accent: #f0a274;
      --text: #f3ebe5;
      --muted: #c2b5ab;
      --bg: #1c1714;
      --surface: #262019;
      --border: #3d332b;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      system-ui, "Hiragino Sans", "Yu Gothic UI", "Meiryo", sans-serif;
    line-height: 1.8;
    /* 長い英数字（メールアドレスなど）で横にはみ出さない（NF-UX-01） */
    overflow-wrap: anywhere;
  }
  .inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 16px;
  }
  main.inner {
    padding-top: 24px;
    padding-bottom: 48px;
  }
  a {
    color: var(--accent);
  }
  h1 {
    font-size: 1.6rem;
    line-height: 1.4;
  }
  h2 {
    font-size: 1.25rem;
    margin-top: 2em;
    border-bottom: 1px solid var(--border);
  }
  table {
    border-collapse: collapse;
    width: 100%;
  }
  th,
  td {
    border: 1px solid var(--border);
    padding: 6px 8px;
    text-align: left;
    vertical-align: top;
  }
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .site-header .inner {
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .brand {
    font-weight: bold;
    font-size: 1.2rem;
    text-decoration: none;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 16px;
  }
  .notice {
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 12px 16px;
    background: var(--surface);
  }
</style>
