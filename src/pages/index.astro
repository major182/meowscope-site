---
// トップ（要件 F-PG-01）：事業の一言の紹介と、アプリの一覧
import Base from "../layouts/Base.astro";
import { apps } from "../data/apps";
---

<Base
  title="MeowScope"
  description="MeowScope は、暮らしを少し楽にする小さなアプリを作っています。"
>
  <h1>MeowScope</h1>
  <p>暮らしを少し楽にする、小さなアプリを作っています。</p>

  <h2>アプリ</h2>
  <ul class="apps">
    {apps.map((app) => (
      <li>
        <a href={`/apps/${app.slug}/`}>
          <img src={app.icon} alt="" width="64" height="64" />
          <span>
            <strong>{app.name}</strong>
            <br />
            {app.summary}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .apps {
    list-style: none;
    padding: 0;
  }
  .apps a {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .apps img {
    flex: none;
    border-radius: 14px;
  }
  .apps strong {
    color: var(--accent);
  }
</style>
